<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#2e2339">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Gestão Paroquial">
    <title>Gestão Paroquial - Acesso Restrito</title>
    <link rel="manifest" href="manifest.json">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg: #1a1523;
            --card: #2e2339;
            --primaria: #4b2d6e;
            --dourado: #c9a24b;
            --texto: #ffffff;
            --cinza: #a89bb3;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg); color: var(--texto);
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            min-height: 100vh; padding: 20px;
        }
        .logo-area { text-align: center; margin-bottom: 40px; }
        .logo-area i { font-size: 3rem; color: var(--dourado); margin-bottom: 15px; }
        .logo-area h1 { font-family: Georgia, serif; font-size: 1.5rem; font-weight: normal; }
        .logo-area p { color: var(--cinza); font-size: 0.9rem; margin-top: 5px; }
        
        .grid-menu {
            display: grid; grid-template-columns: 1fr; gap: 15px; width: 100%; max-width: 400px;
        }
        .card-btn {
            display: flex; align-items: center; gap: 15px; padding: 20px;
            background: var(--card); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px;
            color: var(--texto); text-decoration: none; transition: transform 0.2s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        .card-btn:active { transform: scale(0.97); }
        .card-btn i { font-size: 1.5rem; color: var(--dourado); width: 40px; text-align: center; }
        .card-btn div h2 { font-size: 1.1rem; font-weight: 600; margin-bottom: 3px; }
        .card-btn div p { font-size: 0.8rem; color: var(--cinza); }

        /* Botão de Sair */
        .btn-sair {
            margin-top: 30px; background: none; border: 1px solid var(--cinza); color: var(--cinza);
            padding: 10px 20px; border-radius: 20px; cursor: pointer; font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <div class="logo-area">
        <i class="fas fa-shield-halved"></i>
        <h1>Portal de Gestão</h1>
        <p>Paróquia São João Bosco</p>
    </div>

    <div class="grid-menu">
        <!-- O "../" indica que os arquivos estão na pasta anterior (raiz) -->
        <a href="../admin.html" class="card-btn">
            <i class="fas fa-user-gear"></i>
            <div>
                <h2>Painel Admin</h2>
                <p>Gerenciamento geral</p>
            </div>
        </a>

        <a href="../secretaria.html" class="card-btn">
            <i class="fas fa-file-signature"></i>
            <div>
                <h2>Secretaria</h2>
                <p>Documentos e registros</p>
            </div>
        </a>

        <a href="../links.html" class="card-btn">
            <i class="fas fa-link"></i>
            <div>
                <h2>Links Úteis</h2>
                <p>Atalhos internos</p>
            </div>
        </a>
    </div>

    <!-- Botão para limpar a sessão (útil se você abrir no computador compartilhado) -->
    <button class="btn-sair" onclick="sessionStorage.clear(); location.reload();">
        <i class="fas fa-right-from-bracket"></i> Bloquear Acesso Novamente
    </button>

</body>
</html>
